{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industrial-agent.local/schemas/perception-detect.schema.json",
  "title": "YOLO Perception Agent Detect Request/Response",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "trace_id",
        "episode_id",
        "task_id",
        "subtask_id",
        "step_id",
        "observation_id",
        "image_sha256",
        "deadline_ms",
        "detector",
        "checkpoint_sha",
        "class_map_sha",
        "config_sha",
        "expected_detection_contract",
        "image",
        "allowed_class_names",
        "thresholds"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^1\\.[0-9]+$"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "episode_id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "subtask_id": {
          "type": "string",
          "minLength": 1
        },
        "step_id": {
          "type": "integer",
          "minimum": 0
        },
        "observation_id": {
          "type": "string",
          "minLength": 1
        },
        "image_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        },
        "detector": {
          "const": "yolo"
        },
        "checkpoint_sha": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "class_map_sha": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "config_sha": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "expected_detection_contract": {
          "const": "1.0"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uri",
            "image_sha256",
            "camera_id",
            "width",
            "height"
          ],
          "properties": {
            "uri": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^cas://sha256/[0-9a-fA-F]{64}$"
            },
            "image_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-fA-F]{64}$"
            },
            "camera_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          }
        },
        "allowed_class_names": {
          "description": "Optional class-map subset only; no instruction, target, robot state or lifecycle summary is exposed.",
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "confidence",
            "iou"
          ],
          "properties": {
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "iou": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "trace_id",
        "episode_id",
        "task_id",
        "subtask_id",
        "step_id",
        "observation_id",
        "image_sha256",
        "detector",
        "checkpoint_sha",
        "class_map_sha",
        "config_sha",
        "status"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^1\\.[0-9]+$"
        },
        "request_id": {
          "type": "string"
        },
        "trace_id": {
          "type": "string"
        },
        "episode_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "subtask_id": {
          "type": "string"
        },
        "step_id": {
          "type": "integer",
          "minimum": 0
        },
        "observation_id": {
          "type": "string"
        },
        "image_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "detector": {
          "const": "yolo"
        },
        "checkpoint_sha": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "class_map_sha": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "config_sha": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "status": {
          "enum": [
            "ok",
            "error",
            "cancelled"
          ]
        },
        "detection_packet": {
          "$ref": "detection-packet.schema.json"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            },
            "retry_after_ms": {
              "type": "integer",
              "minimum": 0
            },
            "details": {
              "type": "object"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "detection_packet"
            ],
            "not": {
              "required": [
                "error"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "error",
                  "cancelled"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "error"
            ],
            "not": {
              "required": [
                "detection_packet"
              ]
            }
          }
        }
      ]
    }
  }
}
