{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industrial-agent.local/schemas/canonical-episode.schema.json",
  "title": "Canonical Episode Structure Manifest",
  "description": "Offline HDF5 episode manifest. It does not alter the frozen online Observation or ActionChunk contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metadata",
    "storage",
    "streams"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "storage": {
      "$ref": "#/$defs/storage"
    },
    "streams": {
      "$ref": "#/$defs/streams"
    }
  },
  "$defs": {
    "nonBlank": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "instruction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "frequencyContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physics_hz",
        "control_hz",
        "render_hz",
        "model_inference_hz"
      ],
      "properties": {
        "physics_hz": {
          "const": 120
        },
        "control_hz": {
          "const": 60
        },
        "render_hz": {
          "const": 30
        },
        "model_inference_hz": {
          "const": 10
        }
      }
    },
    "paddingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "target_length"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "none",
            "zero_masked",
            "repeat_last_masked"
          ]
        },
        "target_length": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "strategy": {
                "enum": [
                  "zero_masked",
                  "repeat_last_masked"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "target_length": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "scene_id",
        "task_id",
        "instruction",
        "scene_seed",
        "git_sha",
        "scene_config_sha256",
        "created_at_utc",
        "outcome",
        "failure_code",
        "wrist_image",
        "offline_gt_included",
        "frequency_contract",
        "padding_policy"
      ],
      "properties": {
        "episode_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        },
        "scene_id": {
          "const": "single_bin_static_handoff_v1"
        },
        "task_id": {
          "$ref": "#/$defs/nonBlank"
        },
        "instruction": {
          "$ref": "#/$defs/instruction"
        },
        "scene_seed": {
          "type": "integer",
          "minimum": 0
        },
        "git_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "scene_config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "created_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "outcome": {
          "enum": [
            "SUCCEEDED",
            "FAILED",
            "SAFE_STOPPED",
            "SAFE_STOP_FAILED"
          ]
        },
        "failure_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "wrist_image": {
          "const": null
        },
        "offline_gt_included": {
          "const": false
        },
        "frequency_contract": {
          "$ref": "#/$defs/frequencyContract"
        },
        "padding_policy": {
          "$ref": "#/$defs/paddingPolicy"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "SUCCEEDED"
              }
            }
          },
          "then": {
            "properties": {
              "failure_code": {
                "const": null
              }
            }
          },
          "else": {
            "properties": {
              "failure_code": {
                "$ref": "#/$defs/nonBlank"
              }
            }
          }
        }
      ]
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "dtype",
        "shape"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "dtype": {
          "$ref": "#/$defs/nonBlank"
        },
        "shape": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "frequency_hz",
        "datasets"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "frequency_hz": {
          "enum": [
            10,
            30,
            60
          ]
        },
        "fallback_count": {
          "type": "integer",
          "minimum": 0
        },
        "valid_count": {
          "type": "integer",
          "minimum": 1
        },
        "datasets": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/dataset"
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "episode_file",
        "structure_file",
        "sha256"
      ],
      "properties": {
        "format": {
          "const": "hdf5"
        },
        "episode_file": {
          "const": "episode.h5"
        },
        "structure_file": {
          "const": "structure.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "streams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cameras",
        "robot_state",
        "actions"
      ],
      "properties": {
        "cameras": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "CAM_A_TOP",
            "CAM_HANDOFF",
            "CAM_B_TOP"
          ],
          "properties": {
            "CAM_A_TOP": {
              "$ref": "#/$defs/stream"
            },
            "CAM_HANDOFF": {
              "$ref": "#/$defs/stream"
            },
            "CAM_B_TOP": {
              "$ref": "#/$defs/stream"
            }
          }
        },
        "robot_state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Arm_A",
            "Arm_B"
          ],
          "properties": {
            "Arm_A": {
              "$ref": "#/$defs/stream"
            },
            "Arm_B": {
              "$ref": "#/$defs/stream"
            }
          }
        },
        "actions": {
          "$ref": "#/$defs/stream"
        }
      }
    }
  }
}
