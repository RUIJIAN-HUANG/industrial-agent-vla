{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industrial-agent.local/schemas/perception-health.schema.json",
  "title": "YOLO Perception Agent Health Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "service",
    "status",
    "checkpoint_sha",
    "class_map_sha",
    "config_sha",
    "supported_task_types",
    "supported_detection_contracts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "service": {
      "const": "yolo"
    },
    "service_version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ready",
        "loading",
        "degraded"
      ]
    },
    "checkpoint_sha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "class_map_sha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "config_sha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "supported_task_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supported_detection_contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+$"
      }
    },
    "queue": {
      "type": "object"
    },
    "device": {
      "type": "object"
    },
    "time_ms": {
      "type": "integer",
      "minimum": 0
    }
  }
}
