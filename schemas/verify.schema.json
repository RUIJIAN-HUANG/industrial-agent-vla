{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industrial-agent.local/schemas/verify.schema.json",
  "title": "Verifier Request/Response",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "trace_id",
        "episode_id",
        "task_id",
        "subtask_id",
        "step_id",
        "postconditions",
        "observations"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^1\\.[0-9]+$"
        },
        "request_id": {
          "type": "string"
        },
        "trace_id": {
          "type": "string"
        },
        "episode_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "subtask_id": {
          "type": "string"
        },
        "step_id": {
          "type": "integer",
          "minimum": 0
        },
        "postconditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "task.schema.json#/$defs/postcondition"
          }
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "items": {
            "$ref": "online-observation.schema.json"
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "trace_id",
        "episode_id",
        "task_id",
        "subtask_id",
        "step_id",
        "verdict",
        "failure_code",
        "conditions"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^1\\.[0-9]+$"
        },
        "request_id": {
          "type": "string"
        },
        "trace_id": {
          "type": "string"
        },
        "episode_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "subtask_id": {
          "type": "string"
        },
        "step_id": {
          "type": "integer"
        },
        "verdict": {
          "enum": [
            "PASS",
            "FAIL",
            "UNCERTAIN"
          ]
        },
        "failure_code": {
          "type": "string"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
