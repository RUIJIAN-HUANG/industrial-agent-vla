{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industrial-agent.local/schemas/executor-infer.schema.json",
  "title": "Executor Infer Request/Response Envelope",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "trace_id",
        "episode_id",
        "task_id",
        "subtask_id",
        "step_id",
        "observation_id",
        "deadline_ms",
        "executor",
        "checkpoint_sha",
        "norm_stats_sha",
        "expected_action_contract",
        "model_input"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^1\\.[0-9]+$"
        },
        "request_id": {
          "type": "string"
        },
        "trace_id": {
          "type": "string"
        },
        "episode_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "subtask_id": {
          "type": "string"
        },
        "step_id": {
          "type": "integer",
          "minimum": 0
        },
        "observation_id": {
          "type": "string"
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 1
        },
        "executor": {
          "enum": [
            "openvla_oft",
            "pi05"
          ]
        },
        "checkpoint_sha": {
          "type": "string",
          "minLength": 7
        },
        "norm_stats_sha": {
          "type": "string",
          "minLength": 7
        },
        "expected_action_contract": {
          "const": "1.0"
        },
        "model_input": {
          "type": "object"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "trace_id",
        "episode_id",
        "task_id",
        "subtask_id",
        "step_id",
        "observation_id",
        "executor",
        "checkpoint_sha",
        "norm_stats_sha",
        "status"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^1\\.[0-9]+$"
        },
        "request_id": {
          "type": "string"
        },
        "trace_id": {
          "type": "string"
        },
        "episode_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "subtask_id": {
          "type": "string"
        },
        "step_id": {
          "type": "integer",
          "minimum": 0
        },
        "observation_id": {
          "type": "string"
        },
        "executor": {
          "enum": [
            "openvla_oft",
            "pi05"
          ]
        },
        "checkpoint_sha": {
          "type": "string"
        },
        "norm_stats_sha": {
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "error",
            "cancelled"
          ]
        },
        "action_chunk": {
          "$ref": "action-chunk.schema.json"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "retry_after_ms": {
              "type": "integer",
              "minimum": 0
            },
            "details": {
              "type": "object"
            }
          }
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "queue_ms": {
              "type": "number",
              "minimum": 0
            },
            "inference_ms": {
              "type": "number",
              "minimum": 0
            },
            "total_ms": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "action_chunk"
            ],
            "not": {
              "required": [
                "error"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "error",
                  "cancelled"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "error"
            ],
            "not": {
              "required": [
                "action_chunk"
              ]
            }
          }
        }
      ]
    }
  }
}
