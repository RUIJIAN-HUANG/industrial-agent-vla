{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industrial-agent.local/schemas/online-observation.schema.json",
  "title": "Online Observation",
  "description": "Only these top-level fields enter the online Agent. GT, labels, annotations and oracle state are forbidden by the runtime gateway at every nesting depth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_version",
    "observation_id",
    "timestamp_ms",
    "camera",
    "robot",
    "safety",
    "task",
    "quality"
  ],
  "properties": {
    "observation_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Unix epoch milliseconds"
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_image",
        "arm_a_rgb",
        "handoff_rgb",
        "arm_b_rgb"
      ],
      "properties": {
        "full_image": {
          "description": "Immutable image reference shared by the YOLO Agent and selected VLA.",
          "allOf": [
            {
              "$ref": "#/$defs/imageReference"
            },
            {
              "properties": {
                "camera_id": {
                  "enum": [
                    "CAM_A_TOP",
                    "CAM_HANDOFF",
                    "CAM_B_TOP"
                  ]
                },
                "width": {
                  "const": 1280
                },
                "height": {
                  "const": 720
                }
              }
            }
          ]
        },
        "arm_a_rgb": {
          "description": "RGB stream from /World/Cameras/CAM_A_TOP.",
          "allOf": [
            {
              "$ref": "#/$defs/imageReference"
            },
            {
              "properties": {
                "camera_id": {
                  "const": "CAM_A_TOP"
                },
                "width": {
                  "const": 1280
                },
                "height": {
                  "const": 720
                }
              }
            }
          ]
        },
        "handoff_rgb": {
          "description": "RGB stream from /World/Cameras/CAM_HANDOFF.",
          "allOf": [
            {
              "$ref": "#/$defs/imageReference"
            },
            {
              "properties": {
                "camera_id": {
                  "const": "CAM_HANDOFF"
                },
                "width": {
                  "const": 1280
                },
                "height": {
                  "const": 720
                }
              }
            }
          ]
        },
        "arm_b_rgb": {
          "description": "RGB stream from /World/Cameras/CAM_B_TOP.",
          "allOf": [
            {
              "$ref": "#/$defs/imageReference"
            },
            {
              "properties": {
                "camera_id": {
                  "const": "CAM_B_TOP"
                },
                "width": {
                  "const": 1280
                },
                "height": {
                  "const": 720
                }
              }
            }
          ]
        },
        "wrist_image": {
          "description": "The frozen three-camera profile has no wrist camera.",
          "const": null
        }
      }
    },
    "objects": {
      "description": "Legacy sensor-visible postcondition summary. It is never treated as YOLO output or passed through the perception gate.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "object_id",
          "confidence"
        ],
        "properties": {
          "object_id": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "zone_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "robot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_arm",
        "arm_a",
        "arm_b"
      ],
      "properties": {
        "active_arm": {
          "enum": [
            "Arm_A",
            "Arm_B",
            "NONE"
          ]
        },
        "arm_a": {
          "$ref": "#/$defs/armObservation"
        },
        "arm_b": {
          "$ref": "#/$defs/armObservation"
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "emergency_stop",
        "protective_stop",
        "system_fault"
      ],
      "properties": {
        "emergency_stop": {
          "type": "boolean"
        },
        "protective_stop": {
          "type": "boolean"
        },
        "system_fault": {
          "type": [
            "string",
            "boolean",
            "null"
          ]
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "description": "Sensor-derived lifecycle facts only; no simulator ground-truth coordinates.",
      "required": [
        "packed_part_count",
        "bin_at_handoff",
        "bin_at_finished",
        "bin_speed_m_s"
      ],
      "properties": {
        "packed_part_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "bin_at_handoff": {
          "type": "boolean"
        },
        "arm_a_retreated": {
          "type": "boolean"
        },
        "arm_b_retreated": {
          "type": "boolean"
        },
        "bin_at_finished": {
          "type": "boolean"
        },
        "bin_speed_m_s": {
          "type": "number",
          "minimum": 0,
          "description": "Sensor-derived bin speed; simulator oracle state is forbidden."
        },
        "status": {
          "type": "string"
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence"
      ],
      "properties": {
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  },
  "$defs": {
    "imageReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "image_sha256",
        "camera_id",
        "width",
        "height"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^cas://sha256/[0-9a-fA-F]{64}$"
        },
        "image_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "camera_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Frozen scene IDs are CAM_A_TOP, CAM_HANDOFF and CAM_B_TOP."
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      }
    },
    "armObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tcp_pose_m_rad",
        "state",
        "retreated",
        "gripper_open",
        "stationary"
      ],
      "properties": {
        "tcp_pose_m_rad": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "description": "TCP pose [x_m,y_m,z_m,ax_rad,ay_rad,az_rad] in robot_base; the final three values are one rotation vector, not Euler angles.",
          "items": {
            "type": "number"
          }
        },
        "state": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "description": "Canonical state_7d [x_m,y_m,z_m,ax_rad,ay_rad,az_rad,gripper_norm] in robot_base; ax/ay/az form one rotation vector.",
          "items": {
            "type": "number"
          }
        },
        "retreated": {
          "type": "boolean"
        },
        "gripper_open": {
          "type": "boolean",
          "description": "True only after the controller reports release/open confirmation."
        },
        "stationary": {
          "type": "boolean",
          "description": "Controller-backed zero-motion acknowledgement for this arm."
        }
      }
    }
  }
}
