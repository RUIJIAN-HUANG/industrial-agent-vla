{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industrial-agent.local/schemas/online-observation.schema.json",
  "title": "Online Observation",
  "description": "Only these top-level fields enter the online Agent. GT, labels, annotations and oracle state are forbidden by the runtime gateway at every nesting depth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_version",
    "observation_id",
    "timestamp_ms",
    "robot",
    "safety"
  ],
  "properties": {
    "observation_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Unix epoch milliseconds"
    },
    "camera": {
      "type": "object"
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "object_id",
          "confidence"
        ],
        "properties": {
          "object_id": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "zone_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "robot": {
      "type": "object",
      "required": [
        "tcp_pose_m_rad"
      ],
      "properties": {
        "tcp_pose_m_rad": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "number"
          }
        },
        "state": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "emergency_stop",
        "protective_stop",
        "system_fault"
      ],
      "properties": {
        "emergency_stop": {
          "type": "boolean"
        },
        "protective_stop": {
          "type": "boolean"
        },
        "system_fault": {
          "type": [
            "string",
            "boolean",
            "null"
          ]
        }
      }
    },
    "task": {
      "type": "object"
    },
    "quality": {
      "type": "object",
      "properties": {
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
