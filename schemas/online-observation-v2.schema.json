{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industrial-agent.local/schemas/online-observation-v2.schema.json",
  "title": "V2 Online Observation",
  "description": "Sensor-only observation for the V2 single-arm π0.5 closed loop.",
  "type": "object",
  "additionalProperties": false,
  "required": ["observation_version", "observation_id", "timestamp_ms", "camera", "robot", "safety", "task", "quality"],
  "properties": {
    "observation_version": {"type": "string", "pattern": "^2\\.[0-9]+$"},
    "observation_id": {"type": "string", "minLength": 1},
    "timestamp_ms": {"type": "integer", "minimum": 0},
    "camera": {"$ref": "online-observation-common.schema.json#/$defs/camera"},
    "objects": {"$ref": "online-observation-common.schema.json#/$defs/objects"},
    "robot": {"$ref": "online-observation-common.schema.json#/$defs/robot"},
    "safety": {"$ref": "online-observation-common.schema.json#/$defs/safety"},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "target_object_id", "target_slot_id", "status", "terminal", "terminal_confidence", "verification_votes"],
      "properties": {
        "task_id": {"enum": ["P01_TO_S11", "W01_TO_S14"]},
        "target_object_id": {"type": "string", "minLength": 1},
        "target_slot_id": {"type": "string", "pattern": "^S1[1-4]$"},
        "status": {"enum": ["ACTIVE", "SUCCEEDED", "FAILED"]},
        "terminal": {"type": "boolean"},
        "terminal_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "verification_votes": {"type": "integer", "minimum": 0, "maximum": 3}
      }
    },
    "quality": {"$ref": "online-observation-common.schema.json#/$defs/quality"}
  }
}
