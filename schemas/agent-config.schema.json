{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industrial-agent.local/schemas/agent-config.schema.json",
  "title": "Industrial Agent Core Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_version",
    "verification_frames",
    "executor_timeout_ms",
    "image_cas",
    "lifecycle",
    "recovery",
    "safety",
    "telemetry",
    "perception",
    "executors"
  ],
  "properties": {
    "config_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "verification_frames": {
      "const": 3
    },
    "executor_timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    },
    "image_cas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "layout",
        "encoding",
        "digest_scope",
        "max_blob_bytes",
        "max_pixels",
        "cache_max_bytes",
        "missing_retry_count",
        "missing_retry_delay_ms"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "layout": {
          "const": "sha256-v1"
        },
        "encoding": {
          "const": "png"
        },
        "digest_scope": {
          "const": "encoded_bytes"
        },
        "max_blob_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217728
        },
        "max_pixels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "cache_max_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        },
        "missing_retry_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "missing_retry_delay_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "supervisor_nlp",
        "token_sequence",
        "task_profile"
      ],
      "properties": {
        "mode": {
          "const": "FIXED_DUAL_VLA_SERIAL"
        },
        "supervisor_nlp": {
          "const": false
        },
        "token_sequence": {
          "const": [
            "A_ONLY",
            "HANDOFF_VERIFY",
            "B_ONLY",
            "NONE"
          ]
        },
        "task_profile": {
          "$ref": "#/$defs/fixedTaskProfile"
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_replans_per_phase",
        "max_switches_per_run",
        "clear_action_queue_on_recovery",
        "max_decisions_per_strategy_attempt"
      ],
      "properties": {
        "max_replans_per_phase": {
          "const": 1
        },
        "max_switches_per_run": {
          "const": 0
        },
        "clear_action_queue_on_recovery": {
          "const": true
        },
        "max_decisions_per_strategy_attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_contract_version",
        "axis_abs_limits",
        "workspace_by_arm",
        "max_chunk_steps",
        "safe_stop_timeout_ms"
      ],
      "properties": {
        "action_contract_version": {
          "const": "1.0"
        },
        "axis_abs_limits": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "prefixItems": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          ],
          "items": false
        },
        "workspace_by_arm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Arm_A",
            "Arm_B"
          ],
          "properties": {
            "Arm_A": {
              "$ref": "#/$defs/armWorkspace"
            },
            "Arm_B": {
              "$ref": "#/$defs/armWorkspace"
            }
          }
        },
        "max_chunk_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "safe_stop_timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_jsonl_path",
        "require_durable_handoff"
      ],
      "properties": {
        "event_jsonl_path": {
          "type": "string",
          "minLength": 1
        },
        "require_durable_handoff": {
          "const": true
        }
      }
    },
    "perception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "mode",
        "base_url",
        "evidence_jsonl_path",
        "detection_contract_version",
        "checkpoint_sha",
        "class_map_sha",
        "config_sha",
        "timeout_ms",
        "max_attempts",
        "confidence_threshold",
        "iou_threshold"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "mode": {
          "const": "SHADOW_SCORE"
        },
        "base_url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "evidence_jsonl_path": {
          "type": "string",
          "minLength": 1
        },
        "detection_contract_version": {
          "const": "1.0"
        },
        "checkpoint_sha": {
          "$ref": "#/$defs/configuredArtifactDigest"
        },
        "class_map_sha": {
          "$ref": "#/$defs/configuredArtifactDigest"
        },
        "config_sha": {
          "$ref": "#/$defs/configuredArtifactDigest"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        },
        "max_attempts": {
          "const": 1
        },
        "confidence_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "iou_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "executors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "openvla_oft",
        "pi05"
      ],
      "properties": {
        "openvla_oft": {
          "$ref": "#/$defs/executor"
        },
        "pi05": {
          "$ref": "#/$defs/executor"
        }
      }
    }
  },
  "$defs": {
    "artifactDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "configuredArtifactDigest": {
      "oneOf": [
        {
          "const": "REPLACE_WITH_PINNED_SHA"
        },
        {
          "$ref": "#/$defs/artifactDigest"
        }
      ]
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "base_url",
        "checkpoint_sha",
        "norm_stats_sha"
      ],
      "properties": {
        "enabled": {
          "const": true
        },
        "base_url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "checkpoint_sha": {
          "$ref": "#/$defs/configuredArtifactDigest"
        },
        "norm_stats_sha": {
          "$ref": "#/$defs/configuredArtifactDigest"
        }
      }
    },
    "armWorkspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame",
        "min_m",
        "max_m"
      ],
      "properties": {
        "frame": {
          "const": "robot_base"
        },
        "min_m": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "max_m": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "fixedTaskProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "primary_executor",
        "collaborative_executor",
        "arm_a_id",
        "arm_b_id",
        "bin_id",
        "handoff_zone",
        "finished_zone",
        "expected_part_count",
        "handoff_verification_frames",
        "handoff_required_votes",
        "stable_bin_speed_m_s",
        "arm_a_instruction",
        "arm_b_instruction"
      ],
      "properties": {
        "profile_id": {
          "const": "single_bin_pack_handoff_v1"
        },
        "primary_executor": {
          "const": "pi05"
        },
        "collaborative_executor": {
          "const": "openvla_oft"
        },
        "arm_a_id": {
          "const": "Arm_A"
        },
        "arm_b_id": {
          "const": "Arm_B"
        },
        "bin_id": {
          "const": "Bin_01"
        },
        "handoff_zone": {
          "const": "HANDOFF_CENTER"
        },
        "finished_zone": {
          "const": "FINISHED_01"
        },
        "expected_part_count": {
          "const": 4
        },
        "handoff_verification_frames": {
          "const": 3
        },
        "handoff_required_votes": {
          "const": 2
        },
        "stable_bin_speed_m_s": {
          "const": 0.02
        },
        "arm_a_instruction": {
          "const": "将工作区中的四个红色零件依次装入料箱；倒放零件先调整为正向。装箱完成后，将料箱放到中央交接位并返回 HOME_A。失败时重新观察后继续。"
        },
        "arm_b_instruction": {
          "const": "收到 handoff_ready 后，观察中央交接位，抓稳 Bin_01 并保持水平，将其搬到 FINISHED_01，松开夹爪并返回 HOME_B。"
        }
      }
    }
  }
}
