{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industrial-agent.local/schemas/agent-config.schema.json",
  "title": "Industrial Agent Core Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_version",
    "verification_frames",
    "executor_timeout_ms",
    "recovery",
    "safety",
    "executors"
  ],
  "properties": {
    "config_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "verification_frames": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "executor_timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_replans_per_subtask_strategy",
        "max_switches_per_run",
        "allow_switch_back",
        "clear_action_queue_on_recovery",
        "max_decisions_per_strategy_attempt"
      ],
      "properties": {
        "max_replans_per_subtask_strategy": {
          "const": 1
        },
        "max_switches_per_run": {
          "const": 1
        },
        "allow_switch_back": {
          "const": false
        },
        "clear_action_queue_on_recovery": {
          "const": true
        },
        "max_decisions_per_strategy_attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_contract_version",
        "axis_abs_limits",
        "workspace_min_m",
        "workspace_max_m",
        "max_chunk_steps"
      ],
      "properties": {
        "action_contract_version": {
          "const": "1.0"
        },
        "axis_abs_limits": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "prefixItems": [
            {},
            {},
            {},
            {},
            {},
            {},
            {
              "maximum": 1
            }
          ],
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "workspace_min_m": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "workspace_max_m": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "max_chunk_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      }
    },
    "executors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "openvla_oft",
        "pi05"
      ],
      "properties": {
        "openvla_oft": {
          "$ref": "#/$defs/executor"
        },
        "pi05": {
          "$ref": "#/$defs/executor"
        }
      }
    }
  },
  "$defs": {
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_url",
        "checkpoint_sha",
        "norm_stats_sha"
      ],
      "properties": {
        "base_url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "checkpoint_sha": {
          "type": "string",
          "minLength": 7
        },
        "norm_stats_sha": {
          "type": "string",
          "minLength": 7
        }
      }
    }
  }
}
