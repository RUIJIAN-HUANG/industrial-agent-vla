# Copy this file to deploy/.env.production on the Linux GPU model host.
# Every REPLACE_* value is intentionally invalid: production preflight must fail
# until the release owner supplies the immutable artifact identity.

MODEL_BIND_IP=127.0.0.1
MODEL_HEALTH_HOST=127.0.0.1
PI05_PORT=8101
OPENVLA_PORT=8102
YOLO_PORT=8103

PI05_IMAGE_REPOSITORY=registry.example.com/industrial-agent/pi05:0.1.0
PI05_IMAGE_DIGEST=REPLACE_WITH_PI05_IMAGE_SHA256
OPENVLA_IMAGE_REPOSITORY=registry.example.com/industrial-agent/openvla-oft:0.1.0
OPENVLA_IMAGE_DIGEST=REPLACE_WITH_OPENVLA_IMAGE_SHA256
YOLO_IMAGE_REPOSITORY=registry.example.com/industrial-agent/yolo:0.1.0
YOLO_IMAGE_DIGEST=REPLACE_WITH_YOLO_IMAGE_SHA256

PI05_GPU_ID=0
OPENVLA_GPU_ID=1
YOLO_GPU_ID=2
PI05_GPU_MEMORY_FRACTION=0.85

SHARED_CAS_DIR=/mnt/industrial-cas
PI05_CACHE_DIR_HOST=/srv/industrial-agent/cache/pi05
OPENVLA_CACHE_DIR_HOST=/srv/industrial-agent/cache/openvla-oft
YOLO_CACHE_DIR_HOST=/srv/industrial-agent/cache/yolo

PI05_CHECKPOINT_DIR_HOST=/srv/industrial-agent/models/pi05/checkpoint
PI05_NORM_STATS_FILE_HOST=/srv/industrial-agent/models/pi05/norm_stats.json
PI05_CHECKPOINT_SHA=REPLACE_WITH_PI05_CHECKPOINT_SHA256
PI05_NORM_STATS_SHA=REPLACE_WITH_PI05_NORM_STATS_SHA256

OPENVLA_MODEL_DIR_HOST=/srv/industrial-agent/models/openvla-oft
OPENVLA_CHECKPOINT_SHA=REPLACE_WITH_OPENVLA_MANIFEST_SHA256
OPENVLA_NORM_STATS_SHA=REPLACE_WITH_OPENVLA_NORM_STATS_SHA256
OPENVLA_UNNORM_KEY=industrial_arm_b

YOLO_MODEL_FILE_HOST=/srv/industrial-agent/models/yolo/best.pt
YOLO_CHECKPOINT_SHA=REPLACE_WITH_YOLO_CHECKPOINT_SHA256
YOLO_CLASS_MAP_SHA=sha256:839fdb76e458f9148959e727d289a29495130ce9c868b10b57adcaab4323ba06
YOLO_CONFIG_SHA=REPLACE_WITH_YOLO_CONFIG_SHA256
